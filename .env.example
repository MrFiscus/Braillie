# API credentials
DEEPGRAM_API_KEY=
# The voice Braillo speaks with (Deepgram Aura 2 by default; any Deepgram voice name works)
# DEEPGRAM_TTS_MODEL=aura-2-thalia-en

# Claude for Braillo (say "braillo" and ask, or just talk to it) and the optional lesson coach
ANTHROPIC_API_KEY=
# BRAILLIE_LLM_MODEL=claude-haiku-5-5
# BRAILLIE_LLM_BASE_URL=https://api.anthropic.com

# Optional voice I/O settings
VOICE_IO_MOCK=0
VOICE_IO_DEBUG=0
COMMAND_CONFIDENCE_THRESHOLD=0.72
# Listening in noise: raise if other voices in the room get through, lower if a soft-spoken learner is missed
VOICE_IO_NOISE_GATE_DB=6
VOICE_IO_MIC_INDEX=

# Used only by test_mic_pin.py; 0 runs until Ctrl-C.
VOICE_IO_TEST_DURATION=0
